definition
	GENERIC_ENTRY[at0000] matches {    -- Anteckning
		data matches {
			ITEM_TREE[at0001] matches {    -- Item tree
				items cardinality matches {0..*; unordered} matches {
					CLUSTER[at0003] occurrences matches {0..1} matches {    -- Anteckning
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0004] occurrences matches {0..1} matches {    -- AntId
								value matches {
									DV_COUNT matches {*}
								}
							}
							ELEMENT[at0007] occurrences matches {0..1} matches {    -- Tid
								value matches {
									DV_DATE_TIME matches {*}
								}
							}
							ELEMENT[at0008] occurrences matches {0..1} matches {    -- RegTid
								value matches {
									DV_DATE_TIME matches {*}
								}
							}
							CLUSTER[at0009] occurrences matches {0..1} matches {    -- Notering
								items cardinality matches {1..*; unordered} matches {
									ELEMENT[at0014] occurrences matches {0..1} matches {    -- NotId
										value matches {
											DV_COUNT matches {*}
										}
									}
									ELEMENT[at0010] occurrences matches {0..1} matches {    -- Jtext
										value matches {
											DV_TEXT matches {*}
										}
									}
									ELEMENT[at0012] occurrences matches {0..1} matches {    -- Tid
										value matches {
											DV_DATE_TIME matches {*}
										}
									}
									ELEMENT[at0013] occurrences matches {0..1} matches {    -- RegTid
										value matches {
											DV_DATE_TIME matches {*}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

